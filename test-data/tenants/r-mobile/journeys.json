    {
      "id": "journey-rm-device-protection-hybrid",
      "tenant_id": "r-mobile",
      "name": "Device Protection Claim",
      "description": "Hybrid regulated workflow for damaged-device claims, credits, and approval boundaries",
      "execution_mode": "hybrid",
      "status": "active",
      "version": "1.0.0",
      "nodes": [
        {"id":"n1","type":"start","label":"Start","position":{"x":100,"y":100},"data":{}},
        {"id":"n2","type":"message","label":"Claim Intro","position":{"x":100,"y":200},"data":{"text":"I can help with a device protection claim. Tell me what happened and include your account or order number if you have it."}},
        {"id":"n3","type":"input","label":"Claim Details","position":{"x":100,"y":300},"data":{"prompt":"What happened to the device?","variable":"claim_description"}},
        {"id":"n4","type":"llm_extract","label":"Extract Claim Slots","position":{"x":100,"y":400},"data":{"profile":"rm_device_specialist","allowed_slots":["order_number","damage_type","account_credit_amount"]}},
        {"id":"n5","type":"tool_call","label":"Lookup Device Order","position":{"x":100,"y":500},"data":{"profile":"rm_device_specialist","tool":"order_lookup","input":{"order_number":"{{order_number}}"},"output_map":{"order_id":"order_number","total":"order_total","within_return_window":"within_window"}}},
        {"id":"n6","type":"policy_check","label":"Credit Policy","position":{"x":100,"y":600},"data":{"profile":"rm_device_specialist"}},
        {"id":"n7","type":"condition","label":"Approval Required?","position":{"x":100,"y":700},"data":{"variable":"approval_required","condition":"eq true"}},
        {"id":"n8","type":"llm_draft","label":"Manager Review Draft","position":{"x":0,"y":820},"data":{"profile":"rm_device_specialist","instruction":"Explain that the credit request needs manager approval and summarize next steps.","must_not_claim":["credit approved","refund approved"],"fallback":"This claim needs manager approval before credit can be issued. I have attached the device and order details for review."}},
        {"id":"n9","type":"transfer","label":"Manager Approval","position":{"x":0,"y":940},"data":{"department":"Device Claims","reason":"Credit exceeds approval threshold or policy requires review"}},
        {"id":"n10","type":"llm_draft","label":"Eligible Draft","position":{"x":320,"y":820},"data":{"profile":"rm_device_specialist","instruction":"Explain that the claim is eligible to continue and ask the customer to confirm shipping details.","must_not_claim":["final approval"],"fallback":"The claim is eligible to continue. Please confirm your shipping details so we can proceed."}},
        {"id":"n11","type":"end","label":"End","position":{"x":320,"y":940},"data":{"text":"Thanks for working with R-Mobile."}}
      ],
