      "description": "Hybrid e-commerce refund flow with item reason extraction and policy threshold",
      "execution_mode": "hybrid",
      "status": "active",
      "version": "1.0.0",
      "nodes": [
        {"id":"n1","type":"start","label":"Start","position":{"x":100,"y":100},"data":{}},
        {"id":"n2","type":"message","label":"Intro","position":{"x":100,"y":200},"data":{"text":"I can help review a refund request. Please describe the issue and include your order number."}},
