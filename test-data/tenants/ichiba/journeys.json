        {"id":"n4","type":"llm_extract","label":"Extract Refund Slots","position":{"x":100,"y":400},"data":{"profile":"ichiba_refund_specialist","allowed_slots":["order_number","refund_reason","refund_amount"]}},
        {"id":"n5","type":"tool_call","label":"Lookup Order","position":{"x":100,"y":500},"data":{"profile":"ichiba_refund_specialist","tool":"order_lookup","input":{"order_number":"{{order_number}}"},"output_map":{"order_id":"order_number","total":"order_total","within_return_window":"within_window"}}},
