        {"id":"n10","type":"llm_draft","label":"Standard Draft","position":{"x":320,"y":820},"data":{"profile":"ichiba_refund_specialist","instruction":"Explain standard refund next steps with empathy.","must_not_claim":["instant refund"],"fallback":"Your refund request can continue under standard processing. Refunds usually appear in 3-5 business days after approval."}},
