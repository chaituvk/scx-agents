        {"id":"n7","type":"condition","label":"Approval Required?","position":{"x":100,"y":700},"data":{"variable":"approval_required","condition":"eq true"}},
        {"id":"n8","type":"llm_draft","label":"Review Draft","position":{"x":0,"y":820},"data":{"profile":"ichiba_refund_specialist","instruction":"Explain that a high value refund needs approval and reassure the customer.","must_not_claim":["refund approved"],"fallback":"This refund requires specialist approval before it can be processed. I have sent the order and reason for review."}},
