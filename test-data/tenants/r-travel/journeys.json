        {"id":"n5","type":"tool_call","label":"Lookup Booking","position":{"x":100,"y":500},"data":{"profile":"rtravel_disruption_specialist","tool":"order_lookup","input":{"order_number":"{{booking_ref}}"},"output_map":{"order_id":"booking_ref","total":"booking_total"}}},
