# ── Database ────────────────────────────────────────────────────────
# Option A: Docker PostgreSQL (recommended — includes pgvector)
DATABASE_URL=postgresql://sierra:sierra2026@localhost:5432/sierra

# Option B: SQLite fallback (no external server needed)
# DATABASE_URL=                    # Leave empty to use SQLite

# ── Cache ───────────────────────────────────────────────────────────
# Docker Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# ── LLM Providers (at least one recommended for LLM/Hybrid modes) ───
# Ollama (local, free)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ── Auth ────────────────────────────────────────────────────────────
# JWT secret (generate a random string)
JWT_SECRET=change-this-to-a-random-string-min-32-chars
