# ════════════════════════════════════════════════════════════════════
#  Sierra AI — Environment Configuration
#  Copy to .env.local and fill in the section for your chosen provider.
# ════════════════════════════════════════════════════════════════════

# ── Backend provider selector ───────────────────────────────────────
# Which managed backend the app connects to. "auto" infers from whichever
# provider vars are present below.
#   local    → docker-compose Postgres + Redis (or embedded SQLite)
#   supabase → Supabase Postgres (+ optional Upstash/managed Redis)
#   aws      → RDS/Aurora Postgres (+ ElastiCache)
#   gcp      → Cloud SQL/AlloyDB Postgres (+ Memorystore)
BACKEND_PROVIDER=local

# Shared knobs (apply to every Postgres provider)
DB_POOL_MAX=50
# TLS for managed Postgres: default relaxed verification. Options:
#   strict   → verify the server certificate chain
#   disable  → no TLS (local only)
# DB_SSL=strict
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Seed demo tenants + default admin on boot. LOCAL/DEV ONLY — never enable
# against a production database (it creates a well-known admin login).
SEED_ON_BOOT=0

# Auth — REQUIRED. Generate: openssl rand -base64 48
JWT_SECRET=change-this-to-a-random-string-min-32-chars

# ── LLM providers (configure at least one) ──────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-haiku-20240307
# OPENROUTER_API_KEY=sk-or-...

# ════════════════════════════════════════════════════════════════════
#  PROVIDER: local  (docker-compose)
# ════════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://sierra:sierra2026@localhost:5432/sierra
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# No local Postgres? Use the embedded SQLite file instead:
# USE_SQLITE=1

# ════════════════════════════════════════════════════════════════════
#  PROVIDER: supabase
#  Project → Settings → Database → Connection string (URI).
#  Prefer the "Transaction" pooler (port 6543) for serverless/edge.
# ════════════════════════════════════════════════════════════════════
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# Managed Redis for Supabase (no built-in Redis) — Upstash example:
# REDIS_URL=rediss://default:[TOKEN]@[endpoint].upstash.io:6379
# Optional client SDK usage (auth/storage) if adopted later:
# NEXT_PUBLIC_SUPABASE_URL=https://[REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ════════════════════════════════════════════════════════════════════
#  PROVIDER: aws  (RDS/Aurora Postgres + ElastiCache)
# ════════════════════════════════════════════════════════════════════
# AWS_RDS_URL=postgresql://user:pass@your-db.xxxx.us-east-1.rds.amazonaws.com:5432/sierra
# REDIS_URL=rediss://your-cluster.xxxx.cache.amazonaws.com:6379

# ════════════════════════════════════════════════════════════════════
#  PROVIDER: gcp  (Cloud SQL/AlloyDB Postgres + Memorystore)
# ════════════════════════════════════════════════════════════════════
# TCP (public IP or Cloud SQL Auth Proxy):
# GCP_SQL_URL=postgresql://user:pass@10.x.x.x:5432/sierra
# Unix socket (Cloud Run + Cloud SQL connector) — TLS auto-disabled:
# GCP_SQL_URL=postgresql://user:pass@/sierra?host=/cloudsql/PROJECT:REGION:INSTANCE
# CLOUD_SQL_CONNECTION_NAME=PROJECT:REGION:INSTANCE
# REDIS_HOST=10.x.x.x
# REDIS_PORT=6379
